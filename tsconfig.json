{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "noEmit": true, "isolatedModules": true, "resolveJsonModule": true, "esModuleInterop": true,
    "types": ["vite/client", "vitest/globals", "node"], "noUnusedLocals": false
  },
  "include": ["src", "tests", "vite.config.ts"]
}
